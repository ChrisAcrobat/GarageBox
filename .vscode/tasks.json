{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Wait until App and Blueprints listen",
      "type": "shell",
      "command": "for i in $(seq 1 40); do curl -sf -o /dev/null http://127.0.0.1:5500/ && curl -sf -o /dev/null http://127.0.0.1:5501/ && exit 0; sleep 0.25; done; exit 0",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "Open App in external browser",
      "dependsOn": [
        "Wait until App and Blueprints listen"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "python3 -c \"import webbrowser; webbrowser.open('http://127.0.0.1:5500/')\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "Open Blueprints in editor",
      "dependsOn": [
        "Open App in external browser"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "echo \"${input:openBlueprints}\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ],
  "inputs": [
    {
      "id": "openBlueprints",
      "type": "command",
      "command": "workbench.action.browser.open",
      "args": {
        "url": "http://127.0.0.1:5501/",
        "openToSide": false,
        "reuseUrlFilter": "http://127.0.0.1:5501/**"
      }
    }
  ]
}
