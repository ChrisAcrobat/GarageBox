{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Free preview ports",
      "type": "shell",
      "command": "for p in 5500 5501; do fuser -k ${p}/tcp 2>/dev/null || true; done; sleep 0.3; exit 0",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "Serve App :5500",
      "type": "shell",
      "command": "python3 -m http.server 5500 --bind 127.0.0.1 --directory \"src\"",
      "options": {
        "cwd": "${workspaceFolder:Repo}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "http-server",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving HTTP"
        }
      },
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      },
      "dependsOn": [
        "Free preview ports"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Serve Blueprints :5501",
      "type": "shell",
      "command": "python3 -m http.server 5501 --bind 127.0.0.1 --directory \"docs/blueprints\"",
      "options": {
        "cwd": "${workspaceFolder:Repo}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "http-server",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving HTTP"
        }
      },
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "panel": "dedicated",
        "showReuseMessage": false,
        "close": false
      },
      "dependsOn": [
        "Free preview ports"
      ],
      "dependsOrder": "sequence"
    },
    {
      "label": "Wait until App and Blueprints listen",
      "dependsOn": [
        "Serve App :5500",
        "Serve Blueprints :5501"
      ],
      "dependsOrder": "parallel",
      "type": "shell",
      "command": "for i in $(seq 1 50); do curl -sf http://127.0.0.1:5500/ | grep -q \"GarageBox\" && curl -sf http://127.0.0.1:5501/ | grep -q \"Blueprints\" && exit 0; sleep 0.2; done; echo \"Preview servers did not serve the expected pages\" >&2; exit 1",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      }
    },
    {
      "label": "Open Blueprints in editor",
      "dependsOn": [
        "Wait until App and Blueprints listen"
      ],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "echo \"${input:openBlueprints}\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "never",
        "echo": false,
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false,
        "close": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ],
  "inputs": [
    {
      "id": "openBlueprints",
      "type": "command",
      "command": "workbench.action.browser.open",
      "args": {
        "url": "http://127.0.0.1:5501/",
        "openToSide": false,
        "reuseUrlFilter": "http://127.0.0.1:5501/**"
      }
    }
  ]
}
